# Environment variables for AutoList React

# REQUIRED: Your Anthropic API key
VITE_ANTHROPIC_API_KEY=your-sk-ant-key-here

# OPTIONAL: Custom API base URL (leave empty to use official Anthropic API)
# VITE_ANTHROPIC_BASE_URL=https://your-proxy.com

# OPTIONAL: Model override (defaults to claude-sonnet-4-6)
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
